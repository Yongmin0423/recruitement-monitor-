{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recruitment-monitor-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recruitment-monitor",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "secrets": { "required": ["APP_API_TOKEN"] },
  "vars": {
    "APP_BROWSER_BUDGET_MS": "28800000"
  }
}
